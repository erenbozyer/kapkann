# KAPKANN Environment Configuration

# Groq Cloud API Key (Ücretsiz almak için: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model (Groq üzerinde hızlı ve Türkçe kabiliyeti yüksek model)
# Önerilen: llama-3.3-70b-versatile veya qwen-2.5-32b
GROQ_MODEL=llama-3.3-70b-versatile

# Sunucu Ayarları
HOST=0.0.0.0
PORT=8000

# SQLite Vektör Veritabanı Yolu (Opsiyonel, varsayılan: ./kap_vectors.db)
# DB_PATH=./kap_vectors.db
